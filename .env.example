CLINICMASTER_LOGIN_URL=https://pinebushphysioweb.clinicmaster.com/auth/login
CLINICMASTER_CALENDAR_URL=https://pinebushphysioweb.clinicmaster.com/main/control-center/(rightbar:summary)
CLINICMASTER_USERNAME=
CLINICMASTER_PASSWORD=

HEADLESS=true
LOG_LEVEL=info
TIMEZONE=America/Toronto

# Twilio (SMS) — leave blank to disable
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_PHONE_NUMBER=

# Gmail SMTP (email fallback) — leave blank to disable
# For Gmail: SMTP_USER is your gmail, SMTP_PASS is an app password (not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
ALERT_EMAIL=

# Scheduler — 8:55 PM Sun-Thu in TIMEZONE
SCHEDULE_CRON=55 20 * * 0-4
